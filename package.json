{
  "name": "slack-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
