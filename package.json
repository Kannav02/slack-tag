    "check": "npm run check:dependencies && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/ws": "8.18.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "ws": "8.21.3",
    "zod": "4.6.5"
  }
}
