# Root-owned, mode 0600. Never pass this env file to the agent container.
GITHUB_REPOSITORY=owner/repository
# Enable only after GitHub rules forbid force pushes AND deletions for every writable ref,
# without bypass for this credential's identity. CLI policy is not a protocol security boundary.
GIT_ALLOW_PUSH=0
# Lets the agent's open_pull_request tool open or find pull requests from jeff/* branches.
# Needs pushes; the host GitHub account authors the pull requests.
GIT_ALLOW_PULL_REQUESTS=0
